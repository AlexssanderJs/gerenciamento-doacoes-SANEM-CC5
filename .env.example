# SANEM - ambiente local com Docker Compose
# Copie para .env e gere um JWT_SECRET aleatório com pelo menos 32 bytes.
# O Compose inicia o PostgreSQL automaticamente e configura o backend para
# conectar em postgres:5432 dentro da rede Docker.

POSTGRES_PASSWORD=sanem123
POSTGRES_PORT=5432
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=

# Opcional
APP_FRONTEND_URL=http://localhost:3000
