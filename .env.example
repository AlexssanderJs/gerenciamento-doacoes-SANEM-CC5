# SANEM - variáveis de ambiente
# Copie para .env e preencha os valores. O .env não é versionado.
#
# Banco de dados: PostgreSQL hospedado no NeonDB (nuvem) — NÃO há Postgres local.
# Use a connection string do seu projeto Neon (host "without connection pooling").

# --- Banco de dados (NeonDB) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>.neon.tech/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<usuario-neon>
SPRING_DATASOURCE_PASSWORD=<senha-neon>

# dev = Flyway aplica schema + seed (db/seed); prod = somente schema (sobe limpo)
SPRING_PROFILES_ACTIVE=dev

# --- Segurança ---
# Gere um valor aleatório com pelo menos 32 bytes, ex.: openssl rand -base64 48
JWT_SECRET=

# --- E-mail (dev: mailpit via docker-compose; UI em http://localhost:8025) ---
MAIL_HOST=mailpit
MAIL_PORT=1025

# --- Outros ---
PRIVACY_POLICY_VERSION=SANEM-PRIVACY-1.1
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Opcional
APP_FRONTEND_URL=http://localhost:3000
